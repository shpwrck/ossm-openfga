FROM docker.io/library/golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /ext-authz-bridge .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /ext-authz-bridge /ext-authz-bridge
ENTRYPOINT ["/ext-authz-bridge"]
